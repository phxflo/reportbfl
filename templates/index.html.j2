<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="google" content="notranslate">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.tagline }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cg stroke='%23fff' stroke-width='2'%3E%3Ccircle cx='32' cy='11.5' r='10.5' fill='%231d1d1f'/%3E%3Ccircle cx='49.8' cy='21.8' r='10.5' fill='%231d1d1f'/%3E%3Ccircle cx='49.8' cy='42.3' r='10.5' fill='%231d1d1f'/%3E%3Ccircle cx='32' cy='52.5' r='10.5' fill='%231d1d1f'/%3E%3Ccircle cx='14.2' cy='42.3' r='10.5' fill='%231d1d1f'/%3E%3Ccircle cx='14.2' cy='21.8' r='10.5' fill='%231d1d1f'/%3E%3Ccircle cx='32' cy='32' r='10' fill='%23ff9f0a'/%3E%3C/g%3E%3C/svg%3E">
<style>
{{ fontcss|safe }}
:root{
  color-scheme:light dark;
  --ground:#f5f5f7; --card:#fff; --ink:#1d1d1f; --muted:#6e6e73; --faint:#6e6e73; --hair:rgba(0,0,0,.09); --fill:rgba(0,0,0,.05);
  --blue:#0066cc; --orange:#b64400; --orange-bg:rgba(255,149,0,.14); --mark:#1d1d1f; --accent:#ff9f0a;
  --shadow:0 1px 2px rgba(0,0,0,.04),0 6px 20px rgba(0,0,0,.05);
  --r:20px;
  --sans:-apple-system,BlinkMacSystemFont,"SF Pro Text","Inter","Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --display:-apple-system,BlinkMacSystemFont,"SF Pro Display","Inter","Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  /* Rubrikfarben (Apple-Systempalette), immer zusammen mit der Beschriftung */
  --c-haefen:#0a8fa8;--c-kraene:#e0a800;--c-industrie:#f07800;--c-tiefbau:#a2845e;--c-markt:#a64fd6;--c-laender:#f2305a;--c-rohstoffe:#007aff;
}
@media (prefers-color-scheme:dark){:root{
  --ground:#000; --card:#1c1c1e; --ink:#f5f5f7; --muted:#a1a1a6; --faint:#8e8e93; --hair:rgba(255,255,255,.1); --fill:rgba(255,255,255,.08);
  --blue:#2997ff; --orange:#ff9f0a; --orange-bg:rgba(255,159,10,.16); --mark:#f5f5f7;
  --shadow:none;
  --c-haefen:#5ac8de;--c-kraene:#ffd60a;--c-industrie:#ff9f0a;--c-tiefbau:#c4a77d;--c-markt:#bf5af2;--c-laender:#ff375f;--c-rohstoffe:#0a84ff;
}}
.r-haefen{--rc:var(--c-haefen)}.r-kraene{--rc:var(--c-kraene)}.r-industrie{--rc:var(--c-industrie)}.r-tiefbau{--rc:var(--c-tiefbau)}
.r-markt{--rc:var(--c-markt)}.r-laender{--rc:var(--c-laender)}.r-rohstoffe{--rc:var(--c-rohstoffe)}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:72px;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--ground);color:var(--ink);font:17px/1.47 var(--sans);letter-spacing:-.011em;-webkit-font-smoothing:antialiased;font-optical-sizing:auto}
::selection{background:color-mix(in srgb,var(--blue) 24%,transparent)}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--blue);outline-offset:3px;border-radius:6px}
.wrap{max-width:1080px;margin:0 auto;padding:0 28px}
.gone{display:none!important}

.sample{background:var(--accent);color:#1d1300;font:600 13px/1.4 var(--sans);letter-spacing:0;text-align:center;padding:8px 16px}
.errors{background:var(--card);border-radius:14px;box-shadow:var(--shadow);font-size:14px;padding:12px 18px;margin:0 0 28px;color:var(--muted)}
.errors strong{color:var(--ink)}

/* Kopf */
.top{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:28px 40px;padding-top:64px;padding-bottom:40px}
.brand{display:flex;align-items:center;gap:20px;min-width:0}
.top .mark{width:64px;height:64px;flex:none}
.top h1{margin:0;font:700 56px/1 var(--display);letter-spacing:-.034em}
.top h1 span{color:var(--muted)}
.top .tag{margin:10px 0 0;font-size:15px;color:var(--muted);letter-spacing:-.01em}
.stand{display:flex;flex-direction:column;align-items:flex-end;gap:2px;font-size:13px;line-height:1.45;color:var(--muted);font-variant-numeric:tabular-nums;padding-bottom:6px}
.stand b{font:600 15px/1.4 var(--display);color:var(--ink);letter-spacing:-.01em}
.stand .st{display:inline-flex;align-items:center;gap:7px;margin-top:6px;font-weight:500;color:var(--ink);background:var(--card);box-shadow:var(--shadow),0 0 0 .5px var(--hair);border-radius:99px;padding:4px 12px 4px 10px}
.stand .st::before{content:"";width:7px;height:7px;border-radius:50%;background:#34c759}
.stand .st.warn::before{background:#ff9f0a}.stand .st.bad::before{background:#ff3b30}
.stand .st:hover{color:var(--blue)}

/* Navigation: durchscheinende Leiste, aktive Rubrik wie ein Segment-Schalter */
nav{position:sticky;top:0;z-index:10;background:color-mix(in srgb,var(--ground) 78%,transparent);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid var(--hair);margin-bottom:44px}
nav .wrap{display:flex;gap:2px;align-items:center;padding-top:8px;padding-bottom:8px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
nav .wrap::-webkit-scrollbar{display:none}
nav a{display:flex;align-items:center;gap:7px;flex:none;font-size:14px;font-weight:500;padding:6px 13px;border-radius:99px;white-space:nowrap;color:var(--muted);transition:background .2s,color .2s,box-shadow .2s}
nav a:hover{color:var(--ink)}
nav a::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--rc,var(--faint))}
nav a.on{color:var(--ink);background:var(--card);box-shadow:0 1px 3px rgba(0,0,0,.08),0 0 0 .5px var(--hair)}
nav a b{font-size:12px;font-weight:600;color:var(--faint);font-variant-numeric:tabular-nums}
nav a.on b{color:var(--muted)}
nav .sep{width:1px;height:18px;background:var(--hair);margin:0 8px;flex:none}
nav .navbrand{gap:8px;padding:6px 0;max-width:0;opacity:0;overflow:hidden;color:var(--ink);font:600 15px var(--display);letter-spacing:-.015em;transition:max-width .4s cubic-bezier(.2,.8,.2,1),opacity .3s,margin .4s}
nav .navbrand::before{content:none}
nav .navbrand:hover{color:var(--ink);background:none}
nav.stuck .navbrand{max-width:180px;opacity:1;margin-right:14px}
.nm{width:20px;height:20px;flex:none}

/* Überschriften: große Gruppenzeile, darunter kleine Rubriktitel mit Farbpunkt */
.grouphead{display:flex;align-items:baseline;gap:16px;margin:72px 0 20px;font:700 34px/1.1 var(--display);letter-spacing:-.026em}
.grouphead small{margin-left:auto;font:400 13px var(--sans);letter-spacing:0;color:var(--faint);white-space:nowrap}
main>section:first-child .grouphead,main>.grouphead:first-child{margin-top:0}
h3.kicker{display:flex;align-items:center;gap:9px;margin:0 0 12px;font:600 21px/1.2 var(--display);letter-spacing:-.018em}
h3.kicker i{width:9px;height:9px;border-radius:50%;background:var(--rc);flex:none;font-size:0}
section{margin-bottom:40px}
.box{background:var(--card);border-radius:var(--r);box-shadow:var(--shadow);overflow:hidden}

/* Kennzahlen */
.charts{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin:0 -28px;padding:0 28px 6px;scroll-padding:0 28px}
.charts::-webkit-scrollbar{display:none}
.charts .chart{flex:0 0 min(86%,420px);scroll-snap-align:start}
@media (min-width:900px){.charts{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;overflow:visible;margin:0;padding:0}.charts .chart{flex:none}}
.chart{background:var(--card);border-radius:var(--r);box-shadow:var(--shadow);padding:24px 26px 14px}
.chart header{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}
.chart h3{margin:0;font:600 17px/1.3 var(--display);letter-spacing:-.016em}
.chart .sub{font-size:13px;color:var(--muted);margin-top:3px;letter-spacing:-.005em}
.chart .val{text-align:right;flex:none}
.chart .big{font:600 44px/1 var(--display);letter-spacing:-.035em;font-variant-numeric:tabular-nums}
.chart .per{font-size:12px;color:var(--muted);margin-top:6px}
.deltas{display:flex;gap:6px 18px;font-size:13px;font-weight:600;margin:12px 0 8px;flex-wrap:wrap;font-variant-numeric:tabular-nums}
.deltas span em{font-style:normal;font-weight:400;color:var(--muted)}
.chart svg{width:100%;height:auto;display:block;overflow:visible}
.chart text{font:500 10.5px var(--sans);fill:var(--faint);letter-spacing:0}
.chart .grid{stroke:var(--hair);stroke-width:1}
.chart .line{fill:none;stroke:var(--blue);stroke-width:2.2;stroke-linejoin:round;stroke-linecap:round}
.chart .area{fill:var(--blue);opacity:.08}
.chart .dot{fill:var(--blue);stroke:var(--card);stroke-width:2.5}
.chart .hit{fill:transparent}
.chart .hit:hover{fill:color-mix(in srgb,var(--blue) 30%,transparent)}
.chart footer{font-size:11.5px;color:var(--faint);padding:6px 0 4px}
.chart footer a{color:var(--blue)}
.chart footer a:hover{text-decoration:underline}

/* Bausteine einer Meldung */
.meta{font-size:13px;color:var(--muted);display:flex;flex-wrap:wrap;gap:4px 8px;align-items:center;letter-spacing:-.005em}
.cty{font-size:13px;font-weight:500;color:var(--muted)}
.pill{font-size:11px;font-weight:600;letter-spacing:.01em;padding:2px 8px;border-radius:99px;white-space:nowrap}
.pill.new{background:var(--orange-bg);color:var(--orange)}
.pill.k{background:var(--ink);color:var(--card)}
.bericht{margin-top:10px;font-size:15px;line-height:1.5}
.bericht summary{display:inline-flex;align-items:center;gap:6px;cursor:pointer;color:var(--blue);font-weight:500;font-size:14px;list-style:none;border-radius:6px}
.bericht summary::-webkit-details-marker{display:none}
.bericht summary::after{content:"";width:6px;height:6px;border:solid currentColor;border-width:0 1.6px 1.6px 0;transform:rotate(45deg) translate(-2px,-2px);transition:transform .2s}
.bericht[open] summary::after{transform:rotate(-135deg) translate(-1px,-1px)}
.bericht summary:hover{text-decoration:underline;text-underline-offset:3px}
.bericht p{margin:8px 0 6px;max-width:64ch;color:var(--ink)}
.bq{display:flex;flex-wrap:wrap;gap:2px 14px;font-size:12.5px}
.bq a{color:var(--muted)}
.bq a:hover{color:var(--blue)}

/* Ampel */
.rate{display:inline-flex;gap:8px;flex:none;align-self:flex-start;margin:4px 0 0}
.rb{box-sizing:border-box;width:16px;height:16px;border-radius:50%;border:1.6px solid var(--rb);background:transparent;padding:0;cursor:pointer;opacity:.7;position:relative;transition:opacity .2s,background .2s,transform .2s}
.rb::after{content:"";position:absolute;inset:-3px}
.rb.g{--rb:#34c759}.rb.y{--rb:#ff9f0a}.rb.r{--rb:#ff3b30;margin-left:6px}
.row:hover .rb,.row:focus-within .rb{opacity:.9}
.rb:hover{opacity:1;transform:scale(1.12)}
.rb.sel{opacity:1;background:var(--rb)}
.rb:focus-visible{opacity:1;outline-offset:2px;border-radius:50%}
.undo{grid-column:1/-1;font-size:14px;color:var(--muted)}
.undo button{font:500 14px var(--sans);color:var(--blue);background:none;border:0;padding:4px 2px;cursor:pointer}
.undo button:hover{text-decoration:underline;text-underline-offset:3px}
.row.off{padding:10px 0}.row.off>:not(.undo){display:none}
@media (hover:none){.rb{opacity:.85}}

/* Rubriken: Listen mit eingerückten Haarlinien wie in Apples Apps */
.rows{padding:6px 26px}
.rows>.row:first-child{border-top-color:transparent}
.row>div:nth-child(2){max-width:72ch}
.tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 24px;align-items:stretch;margin-bottom:40px}
.tiles section{margin:0;display:flex;flex-direction:column;min-width:0}.tiles .box{flex:1}
.row{display:grid;grid-template-columns:56px minmax(0,1fr) auto;gap:14px;padding:16px 0;border-top:1px solid var(--hair)}
.when{font-size:12px;line-height:1.45;color:var(--faint);padding-top:3px;font-variant-numeric:tabular-nums}
.row .h{font:600 17px/1.38 var(--display);letter-spacing:-.018em}
a.h:hover{color:var(--blue)}
.row .meta{margin-top:4px}
.empty{font-size:15px;color:var(--faint);padding:20px 26px}

/* Systemstatus und Fuß */
.health{margin:0 0 14px;font-size:13px}
.health summary{cursor:pointer;color:var(--muted);list-style:none;border-radius:6px}
.health summary::-webkit-details-marker{display:none}
.health summary:hover{color:var(--ink)}
.health summary::after{content:"";display:inline-block;width:5px;height:5px;margin-left:8px;border:solid currentColor;border-width:0 1.5px 1.5px 0;transform:rotate(45deg) translate(-2px,-1px);transition:transform .2s}
.health[open] summary::after{transform:rotate(-135deg) translate(-1px,0)}
.health .dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:8px;vertical-align:baseline;background:#34c759}
.health .warn .dot,.health .dot.warn{background:#ff9f0a}.health .bad .dot,.health .dot.bad{background:#ff3b30}
.health ul{list-style:none;margin:10px 0 0;padding:0}.health li{padding:3px 0;color:var(--muted)}.health li b{color:var(--ink);font-weight:600;margin-right:6px}
.healthbar{background:color-mix(in srgb,#ff3b30 12%,var(--card));color:var(--ink);font-size:13px;padding:9px 16px;text-align:center}
footer.site{border-top:1px solid var(--hair);margin-top:64px;padding:26px 0 56px;font-size:13px;line-height:1.65;color:var(--faint)}
footer.site strong{color:var(--ink)}
footer.site input{font:14px var(--sans);padding:7px 12px;border:1px solid var(--hair);border-radius:10px;background:var(--card);color:var(--ink);min-width:240px}
footer.site button{font:500 13px var(--sans);border:0;background:var(--fill);color:var(--ink);border-radius:99px;padding:7px 14px;cursor:pointer;margin-left:6px}
footer.site button:hover{background:color-mix(in srgb,var(--ink) 12%,transparent)}

@media (max-width:600px){
  body{font-size:16px}.wrap{padding:0 18px}
  .top{grid-template-columns:minmax(0,1fr);gap:18px;padding-top:32px;padding-bottom:28px}.top h1{font-size:34px}.top .mark{width:46px;height:46px}.brand{gap:14px}.stand{align-items:flex-start;flex-direction:row;flex-wrap:wrap;gap:2px 10px;align-items:center;padding:0}.stand .st{margin-top:0}nav .navbrand{display:none}
  .grouphead{font-size:28px;margin-top:52px}.grouphead small{display:none}
  .tiles{grid-template-columns:1fr;gap:0}.tiles section{margin-bottom:36px}
  .rows{padding:4px 18px}.row{grid-template-columns:50px minmax(0,1fr);gap:4px 10px}.rate{grid-column:2;margin-top:6px}
  .row .h{font-size:16px}
  .chart{padding:20px 20px 12px}.chart .big{font-size:36px}
  .charts{margin:0 -18px;padding:0 18px 6px;scroll-padding:0 18px}
  .rate{gap:12px}.rb{width:18px;height:18px}.rb::after{inset:-6px}.rb.r{margin-left:4px}
  footer.site input{min-width:0;width:100%;margin-bottom:8px}footer.site button{margin:0 6px 0 0}
}
@media print{nav,.rate,.undo,#ratebox{display:none}.bericht p{display:block}.box,.chart{box-shadow:none;border:1px solid #ddd}}
</style>
</head>
<body>
{% if health|selectattr(1,'equalto','bad')|list %}<div class="healthbar">Störung bei der heutigen Aktualisierung – Details unten im Systemstatus.</div>{% endif %}
{% if sample %}<div class="sample">VORSCHAU MIT BEISPIELDATEN – Überschriften, Quellen und Zahlen sind erfunden. Echte Meldungen erscheinen nach dem ersten automatischen Lauf.</div>{% endif %}

{% macro item(c) %}<a dir="auto" class="h" href="{{ c.url }}" target="_blank" rel="noopener"{% if c.orig %} title="Original: {{ c.orig }}"{% endif %}>{{ c.title }}</a>{% endmacro %}

{% macro badges(c) %}{% if c.trusted %}<span>·&nbsp;Fachmedium</span>{% endif %}{% if c.n > 1 %}<span>·&nbsp;{{ c.n }}&nbsp;Quellen</span>{% endif %}{% endmacro %}

{% macro chips(c) %}{% if c.countries %}<span class="cty">{{ c.countries|map(attribute="name")|join(", ") }}</span>{% endif %}{% if c.is_new %}<span class="pill new">NEU</span>{% endif %}{% if c.kunde %}<span class="pill k">Kunde</span>{% endif %}{% endmacro %}

{% macro xbtn() %}<span class="rate" role="group" aria-label="Bewertung"><button class="rb g" type="button" data-r="g" title="Gut" aria-label="Gut" aria-pressed="false"></button><button class="rb y" type="button" data-r="y" title="Grenzwertig: falsche Rubrik oder nur am Rande" aria-label="Grenzwertig" aria-pressed="false"></button><button class="rb r" type="button" data-r="r" title="Unpassend – ausblenden" aria-label="Unpassend, ausblenden" aria-pressed="false"></button></span>{% endmacro %}

{% macro bericht(c) %}{% if c.bericht %}<details class="bericht"><summary>Hintergrund</summary><p>{{ c.bericht.text }}</p>{% if c.bericht.quellen %}<div class="bq">{% for q in c.bericht.quellen %}<a href="{{ q.u }}" target="_blank" rel="noopener noreferrer">{{ q.t }}</a>{% endfor %}</div>{% endif %}</details>{% endif %}{% endmacro %}
{% macro row(c) %}
<article class="row" data-id="{{ c.id }}" data-rate="{{ c.rate or '' }}">
  <div class="when">{{ c.when }}</div>
  <div>{% if c.countries or c.is_new or c.kunde %}<div class="meta" style="margin-bottom:4px">{{ chips(c) }}</div>{% endif %}{{ item(c) }}<div class="meta"><span>{{ c.source }}</span>{{ badges(c) }}</div>{{ bericht(c) }}</div>
  {{ xbtn() }}
</article>
{% endmacro %}

{% macro mark(cls) %}<svg class="{{ cls }}" viewBox="0 0 64 64"{% if cls == "mark" %} role="img" aria-label="Querschnitt eines Drahtseils"{% else %} aria-hidden="true"{% endif %}><g stroke="var(--card)" stroke-width="2">{% for k in range(6) %}<circle cx="{{ (32 + 20.5 * [0, 0.866, 0.866, 0, -0.866, -0.866][k])|round(1) }}" cy="{{ (32 - 20.5 * [1, 0.5, -0.5, -1, -0.5, 0.5][k])|round(1) }}" r="10.5" fill="var(--mark)"/>{% endfor %}<circle cx="32" cy="32" r="10" fill="var(--accent)"/></g><g fill="var(--card)" opacity=".35">{% for k in range(6) %}<circle cx="{{ (32 + 20.5 * [0, 0.866, 0.866, 0, -0.866, -0.866][k])|round(1) }}" cy="{{ (32 - 20.5 * [1, 0.5, -0.5, -1, -0.5, 0.5][k])|round(1) }}" r="3.4"/>{% endfor %}</g></svg>{% endmacro %}
{% set lvl = 'bad' if health|selectattr(1,'equalto','bad')|list else ('warn' if health|selectattr(1,'equalto','warn')|list else 'ok') %}
<header class="wrap top" id="top">
  <div class="brand">{{ mark("mark") }}
    <div><h1>{{ site.title.split(' ')[0] }} <span>{{ site.title.split(' ')[1:]|join(' ') }}</span></h1>
    <p class="tag">{{ site.tagline }}</p></div></div>
  <div class="stand"><b>{{ date }}</b><span>Stand {{ updated.split(', ')[-1] }}</span><a href="#status" class="st {{ lvl }}">{{ 'Alles in Ordnung' if lvl == 'ok' else 'Hinweise' if lvl == 'warn' else 'Störung' }}</a></div>
</header>

<nav aria-label="Rubriken"><div class="wrap">
  <a class="navbrand" href="#top" tabindex="-1">{{ mark("nm") }}{{ site.title }}</a>
  <a href="#kennzahlen">Kennzahlen</a><span class="sep"></span>
  {% for s in sections %}{% if not s.tile %}<a class="r-{{ s.id }}" href="#{{ s.id }}">{{ s.short }}{% if s.shown %}<b>{{ s.shown|length }}</b>{% endif %}</a>
  {%- elif loop.first or not sections[loop.index0 - 1].tile %}{% set n = sections|selectattr('tile')|map(attribute='shown')|map('length')|sum %}<a href="#zielmaerkte">{{ s.group }}{% if n %}<b>{{ n }}</b>{% endif %}</a>{% endif %}{% endfor %}
</div></nav>

<main class="wrap">
  {% if errors %}<div class="errors"><strong>Hinweis zu den Kennzahlen:</strong> {{ errors|join(' · ') }}</div>{% endif %}

  {% if charts %}
  <section id="kennzahlen">
    <h2 class="grouphead">Kennzahlen<small>Quelle: Statistisches Bundesamt (Destatis)</small></h2>
    <div class="charts">
      {% for c in charts %}
      <div class="chart">
        <header>
          <div><h3>{{ c.title }}</h3><div class="sub">{{ c.sub }}</div></div>
          <div class="val"><div class="big">{{ c.latest }}</div><div class="per">{{ c.period }}</div></div>
        </header>
        <div class="deltas">
          {% if c.d1 is not none %}<span>{{ c.d1|arrow }} <em>ggü. {{ c.d1_label }}</em></span>{% endif %}
          {% if c.note %}<span>{{ c.note }}</span>{% endif %}
          {% if c.d12 is not none %}<span>{{ c.d12|arrow }} <em>ggü. Vorjahr</em></span>{% endif %}
        </div>
        {{ c.svg|safe }}
        <footer>Tabelle <a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.url.split('/')[-1] }}</a> · abgerufen {{ c.fetched }}</footer>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}


  {% for s in sections %}
  {% if s.group and (loop.first or sections[loop.index0 - 1].group != s.group) %}<h2 class="grouphead"{% if s.tile %} id="zielmaerkte"{% endif %}>{{ s.group }}</h2>{% endif %}
  {% if s.tile and (loop.first or not sections[loop.index0 - 1].tile) %}<div class="tiles">{% endif %}
  <section id="{{ s.id }}" class="r-{{ s.id }}" data-section>
    <h3 class="kicker"><i></i>{{ s.short }}</h3>
    <div class="box">
    {% if s.shown %}
    <div class="rows">{% for c in s.shown %}{{ row(c) }}{% endfor %}</div>
    {% else %}<div class="empty">Nichts Neues in den letzten 7 Tagen.</div>{% endif %}
    </div>
  </section>
  {% if s.tile and (loop.last or not sections[loop.index0 + 1].tile) %}</div>{% endif %}
  {% endfor %}
</main>

<div class="wrap"><footer class="site">
  {% if rating %}<details class="health" id="ratebox"><summary><span class="dot" id="tokdot"></span>Bewertungen senden: <span id="tokstat">nicht verbunden</span></summary>
    <div style="margin-top:10px"><input id="tok" type="password" autocomplete="off" placeholder="Zugangsschlüssel" aria-label="Zugangsschlüssel"> <button type="button" id="toksave">Speichern</button><button type="button" id="tokdel">Entfernen</button></div></details>{% endif %}
  <details class="health" id="status"><summary><span class="dot {{ lvl }}"></span>Systemstatus: {{ 'alles in Ordnung' if lvl == 'ok' else 'Hinweise beachten' if lvl == 'warn' else 'Störung – Inhalte evtl. unvollständig' }}</summary>
    <ul>{% for n, s, x in health %}<li class="{{ s }}"><span class="dot {{ s }}"></span><b>{{ n }}</b>{{ x }}</li>{% endfor %}</ul></details>
  Quelle der Kennzahlen: Statistisches Bundesamt (Destatis), GENESIS-Online.
</footer></div>

<script>
(function(){
  var $=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};
  
  /* Navigation: markiert den Bereich, der gerade im Bild ist (bei Kacheln beide Nachbarn) */
  var links=$('nav a[href^="#"]:not(.navbrand)'), secs=links.map(function(a){return document.getElementById(a.getAttribute('href').slice(1))}), navEl=document.querySelector('nav'), tick=false;
  function spy(){
    tick=false; var line=navEl.offsetHeight+60, tops=secs.map(function(s){return s?s.getBoundingClientRect().top:1e9}), best=-1e9;
    tops.forEach(function(y){if(y<=line&&y>best)best=y});
    if(window.innerHeight+scrollY>=document.documentElement.scrollHeight-4)best=Math.max.apply(null,tops.filter(function(y){return y<1e8}));
    links.forEach(function(a,i){a.classList.toggle('on',tops[i]<1e8&&Math.abs(tops[i]-best)<3)});
    var on=links.filter(function(a){return a.classList.contains('on')})[0], box=navEl.firstElementChild;
    if(on&&box.scrollWidth>box.clientWidth)box.scrollTo({left:on.offsetLeft-(box.clientWidth-on.offsetWidth)/2,behavior:'smooth'});
  }
  addEventListener('scroll',function(){if(!tick){tick=true;requestAnimationFrame(spy)}},{passive:true});
  addEventListener('resize',spy); spy();
  /* Name des Reports erscheint in der Leiste, sobald der Kopf aus dem Bild ist (wie Apples Produktleiste) */
  if('IntersectionObserver' in window)new IntersectionObserver(function(e){navEl.classList.toggle('stuck',!e[0].isIntersecting)}).observe(document.getElementById('top'));

  /* Ampel-Bewertung: lokal merken, gesammelt an GitHub senden (Kommentar im Bewertungs-Issue) */
  var RT={{ rating|tojson if rating else 'null' }}, unrate=function(){};
  if(RT){
    var TOK='', ratings={}, queue=[], flushing=false, timer=null;
    try{TOK=localStorage.getItem('seilTok')||'';ratings=JSON.parse(localStorage.getItem('seilRate')||'{}');queue=JSON.parse(localStorage.getItem('seilQ')||'[]')}catch(e){}
    var saveR=function(){try{localStorage.setItem('seilRate',JSON.stringify(ratings));localStorage.setItem('seilQ',JSON.stringify(queue))}catch(e){}};
    var showR=function(){$('[data-id]').forEach(function(el){
      var r=(ratings[el.dataset.id]||{}).r||el.dataset.rate||'';
      el.querySelectorAll('.rb').forEach(function(b){b.classList.toggle('sel',b.dataset.r===r);b.setAttribute('aria-pressed',b.dataset.r===r)})})};
    var stat=function(msg){
      var s=document.getElementById('tokstat'),d=document.getElementById('tokdot'); if(!s)return;
      var txt=msg||(TOK?'verbunden':'nicht verbunden'); if(TOK&&queue.length&&!msg)txt+=' · '+queue.length+' ausstehend';
      s.textContent=txt; d.className='dot '+(msg?'bad':(TOK?'':'warn'))};
    var flush=function(){
      if(!TOK||!queue.length||flushing)return; flushing=true;
      var batch=queue.slice(0,50);
      fetch('https://api.github.com/repos/'+RT.repo+'/issues/'+RT.issue+'/comments',{method:'POST',
        headers:{'Authorization':'Bearer '+TOK,'Accept':'application/vnd.github+json'},body:JSON.stringify({body:JSON.stringify(batch)})})
      .then(function(r){flushing=false;if(r.ok){queue=queue.slice(batch.length);saveR();stat();if(queue.length)flush()}else stat(r.status===401||r.status===403||r.status===404?'Schlüssel prüfen (Fehler '+r.status+')':'Fehler '+r.status)})
      .catch(function(){flushing=false;stat('offline – wird später gesendet')})};
    document.addEventListener('click',function(e){
      var b=e.target.closest&&e.target.closest('.rb'); if(!b)return;
      var el=b.closest('[data-id]'); if(!el)return;
      var now=Date.now(); ratings[el.dataset.id]={r:b.dataset.r,t:now};
      queue=queue.filter(function(q){return q.i!==el.dataset.id}).concat([{i:el.dataset.id,r:b.dataset.r,t:now}]);
      saveR();showR();stat();clearTimeout(timer);timer=setTimeout(flush,3000)});
    var sv=document.getElementById('toksave'),dl=document.getElementById('tokdel');
    if(sv)sv.addEventListener('click',function(){var v=(document.getElementById('tok').value||'').trim();if(!v)return;TOK=v;try{localStorage.setItem('seilTok',v)}catch(e){};document.getElementById('tok').value='';stat();flush()});
    if(dl)dl.addEventListener('click',function(){TOK='';try{localStorage.removeItem('seilTok')}catch(e){};stat()});
    unrate=function(id){                       /* Rückgängig: „n“ löscht die Bewertung auch im Issue */
      var now=Date.now(); delete ratings[id];
      queue=queue.filter(function(q){return q.i!==id}).concat([{i:id,r:'n',t:now}]);
      saveR();showR();stat();clearTimeout(timer);timer=setTimeout(flush,3000)};
    showR();stat();flush();
  }

  /* Rot bewertet = ausblenden; bis zum Neuladen bleibt eine Zeile mit „Rückgängig“ stehen */
  var hid={}; try{hid=JSON.parse(localStorage.getItem('seilHide')||'{}')}catch(e){}
  var cut=Date.now()-45*864e5; Object.keys(hid).forEach(function(k){if(hid[k].t<cut)delete hid[k]});
  function saveHid(){try{localStorage.setItem('seilHide',JSON.stringify(hid))}catch(e){}}
  function applyHid(){
    $('[data-id]').forEach(function(el){el.classList.toggle('gone',!!hid[el.dataset.id])});
  }
  document.addEventListener('click',function(e){
    var b=e.target.closest&&e.target.closest('.rb.r'); if(!b)return;
    var el=b.closest('[data-id]'); if(!el)return;
    var a=el.querySelector('a.h'); hid[el.dataset.id]={t:Date.now(),s:(a?a.textContent.trim():'').slice(0,160),u:a?a.href:''};
    saveHid();
    if(!el.querySelector('.undo')){var u=document.createElement('div');u.className='undo';u.setAttribute('role','status');
      u.innerHTML='Ausgeblendet · <button type="button">Rückgängig</button>';el.appendChild(u);u.querySelector('button').focus()}
    el.classList.add('off');
  });
  document.addEventListener('click',function(e){
    var b=e.target.closest&&e.target.closest('.undo button'); if(!b)return;
    var el=b.closest('[data-id]'); delete hid[el.dataset.id]; saveHid(); unrate(el.dataset.id);
    el.classList.remove('off'); el.querySelector('.undo').remove(); el.querySelector('.rb.r').focus();
  });
  applyHid();
})();
</script>
</body>
</html>
