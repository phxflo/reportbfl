<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.tagline }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23c2410c'/%3E%3Cpath d='M8 24 L24 8 M8 18 L18 8 M14 24 L24 14' stroke='%23fff' stroke-width='2.5' stroke-linecap='round'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@700;900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#f5f1e8; --card:#fbf9f4; --ink:#17181a; --muted:#5f6368; --rule:#d8d2c3; --rule-strong:#17181a;
  --accent:#c2410c; --accent-soft:rgba(194,65,12,.12); --chip:#ebe5d6;
  --serif:"Source Serif 4",Georgia,"Times New Roman",serif; --display:"Playfair Display","Didot",Georgia,serif; --sans:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme:dark){:root{
  --paper:#121417; --card:#1a1d21; --ink:#ecebe6; --muted:#a2a6ad; --rule:#2c3138; --rule-strong:#ecebe6;
  --accent:#f08a4b; --accent-soft:rgba(240,138,75,.16); --chip:#242830;
}}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:56px}
body{margin:0;background:var(--paper);color:var(--ink);font:17px/1.5 var(--serif);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a:hover .h,a.h:hover{text-decoration:underline;text-decoration-color:var(--accent);text-underline-offset:3px;text-decoration-thickness:2px}
.wrap{max-width:1240px;margin:0 auto;padding:0 20px}
.sans{font-family:var(--sans)}

/* Vorschau-Hinweis */
.sample{background:var(--accent);color:#fff;font:600 13px/1.4 var(--sans);text-align:center;padding:8px 16px}
.errors{background:var(--chip);border-left:4px solid var(--accent);font:13px var(--sans);padding:8px 14px;margin:12px 0}

/* Kopfzeile */
.topbar{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-bottom:1px solid var(--rule);padding:10px 0;font:500 12px var(--sans);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.mast{text-align:center;padding:26px 0 14px;border-bottom:3px double var(--rule-strong)}
.mast h1{margin:0;font:900 clamp(40px,8vw,84px)/1 var(--display);letter-spacing:-.015em}
.mast h1 span{color:var(--accent)}
.mast p{margin:10px 0 0;font:italic 400 clamp(14px,2vw,18px) var(--serif);color:var(--muted)}

/* Navigation */
nav{position:sticky;top:0;z-index:10;background:var(--paper);border-bottom:1px solid var(--rule-strong);margin-bottom:26px}
nav .wrap{display:flex;gap:4px;align-items:center;overflow-x:auto;scrollbar-width:none}
nav a{font:600 12px var(--sans);letter-spacing:.07em;text-transform:uppercase;padding:14px 10px;white-space:nowrap;color:var(--ink)}
nav a:hover{color:var(--accent)}
nav input{margin-left:auto;font:14px var(--sans);padding:7px 12px;border:1px solid var(--rule);border-radius:99px;background:var(--card);color:var(--ink);min-width:150px}

/* Rubrikenkopf */
.kicker{display:flex;align-items:baseline;gap:14px;border-top:3px solid var(--rule-strong);padding-top:10px;margin:0 0 18px}
.kicker b{font:900 14px var(--display);color:var(--accent);letter-spacing:.05em}
.kicker h2{margin:0;font:700 clamp(22px,3vw,30px)/1.15 var(--display)}
.kicker small{margin-left:auto;font:500 12px var(--sans);color:var(--muted);white-space:nowrap}
section{margin-bottom:46px}

/* Kennzahlen */
.charts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px}
.chart{background:var(--card);border:1px solid var(--rule);padding:16px 18px 10px}
.chart header{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.chart h3{margin:0;font:700 19px/1.2 var(--display)}
.chart .sub{font:12px var(--sans);color:var(--muted);margin-top:3px}
.chart .val{text-align:right;flex:none}
.chart .big{font:900 34px/1 var(--display);letter-spacing:-.01em}
.chart .per{font:500 11px var(--sans);color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.deltas{display:flex;gap:16px;font:600 12.5px var(--sans);margin:10px 0 2px;flex-wrap:wrap}
.deltas span em{font-style:normal;font-weight:400;color:var(--muted)}
.chart svg{width:100%;height:auto;display:block;overflow:visible}
.chart text{font:10.5px var(--sans);fill:var(--muted)}
.chart .grid{stroke:var(--rule);stroke-width:1}
.chart .line{fill:none;stroke:var(--accent);stroke-width:2.4;stroke-linejoin:round;stroke-linecap:round}
.chart .area{fill:var(--accent);opacity:.1}
.chart .dot{fill:var(--accent);stroke:var(--card);stroke-width:2}
.chart .hit{fill:transparent}
.chart .hit:hover{fill:var(--accent-soft)}
.chart footer{font:11px var(--sans);color:var(--muted);padding:2px 0 4px}
.chart footer a{text-decoration:underline}

/* Top-News */
.front{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:34px}
.lead .tag,.card .tag{font:600 11px var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
.lead h3{font:900 clamp(28px,4.2vw,46px)/1.08 var(--display);margin:8px 0 12px;letter-spacing:-.01em}
.lead .orig{font:italic 15px/1.4 var(--serif);color:var(--muted);margin:0 0 10px}
.meta{font:12.5px var(--sans);color:var(--muted);display:flex;flex-wrap:wrap;gap:4px 10px;align-items:center}
.pill{font:600 10px var(--sans);letter-spacing:.06em;padding:2px 6px;border-radius:3px;background:var(--chip);color:var(--ink)}
.pill.new{background:var(--accent);color:#fff}
.pill.c{background:transparent;border:1px solid var(--rule)}
.side{display:flex;flex-direction:column}
.side article{padding:14px 0;border-top:1px solid var(--rule)}
.side article:first-child{border-top:0;padding-top:0}
.side h4{margin:4px 0 6px;font:700 19px/1.25 var(--display)}
.numbered{counter-reset:n}
.numbered article{position:relative;padding-left:38px;counter-increment:n}
.numbered article::before{content:counter(n);position:absolute;left:0;top:11px;font:900 28px/1 var(--display);color:var(--accent)}
.numbered article:first-child::before{top:-3px}
.leadwrap{border-right:1px solid var(--rule);padding-right:34px}
.rail{display:grid;gap:22px;align-content:start}
.box{background:var(--card);border:1px solid var(--rule);border-top:3px solid var(--rule-strong);padding:14px 16px}
.box h3{margin:0 0 10px;font:700 12px var(--sans);letter-spacing:.09em;text-transform:uppercase}
.box ul{list-style:none;margin:0;padding:0}
.box li{padding:8px 0;border-top:1px solid var(--rule);font:600 14.5px/1.3 var(--serif)}
.box li:first-child{border-top:0}
.box li .meta{margin-top:3px;font-weight:400}
.radar{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:8px}
.radar a{display:block;background:var(--chip);padding:8px 10px;border-radius:4px;font:600 12px var(--sans)}
.radar a b{display:block;font:900 24px/1.1 var(--display);color:var(--accent)}
.radar a.zero b{color:var(--muted)}
.radar a:hover{outline:2px solid var(--accent)}

/* Rubriken-Raster */
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 28px}
.card{padding:14px 0 16px;border-top:1px solid var(--rule)}
.card h4{margin:5px 0 8px;font:700 19px/1.27 var(--display)}
.card .others{font:12px var(--sans);color:var(--muted);margin-top:4px}
.sec{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:0 28px}
.sec .rest{border-left:1px solid var(--rule);padding-left:28px}
.sec .rest .card:first-child{border-top:0;padding-top:0}
.card.feat{border-top:0;padding-top:0}
.card.feat h4{font:900 clamp(24px,3vw,36px)/1.1 var(--display)}
.card.feat .orig{display:block}
.grid3{margin-top:4px}
.card .orig{display:none;font:italic 14.5px/1.4 var(--serif);color:var(--muted);margin:0 0 8px}
details.more{margin-top:8px}
details.more summary{cursor:pointer;font:600 12px var(--sans);letter-spacing:.07em;text-transform:uppercase;color:var(--accent);padding:6px 0;list-style:none}
details.more summary::before{content:"+ "}
details.more[open] summary::before{content:"− "}
.empty{font:italic 15px var(--serif);color:var(--muted);padding:6px 0 14px}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin:-4px 0 14px}
.chips button{font:600 12px var(--sans);padding:6px 12px;border:1px solid var(--rule);background:var(--card);color:var(--ink);border-radius:99px;cursor:pointer}
.chips button[aria-pressed=true]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.hidden{display:none!important}

footer.site{border-top:3px double var(--rule-strong);padding:22px 0 50px;font:13px/1.6 var(--sans);color:var(--muted)}
footer.site strong{color:var(--ink)}

@media (max-width:980px){
  .front{grid-template-columns:1fr}.leadwrap{border-right:0;padding-right:0}
  .grid3{grid-template-columns:repeat(2,minmax(0,1fr))}
  .sec{grid-template-columns:1fr}.sec .rest{border-left:0;padding-left:0}
}
@media (max-width:600px){
  body{font-size:16px}.wrap{padding:0 16px}
  .grid3{grid-template-columns:1fr}
  nav input{display:none}.kicker small{display:none}
  .chart .big{font-size:28px}
}
@media print{nav,.chips,nav input{display:none}body{background:#fff}}
</style>
</head>
<body>
{% if sample %}<div class="sample">VORSCHAU MIT BEISPIELDATEN – Überschriften, Quellen und Zahlen sind erfunden. Echte Meldungen erscheinen nach dem ersten automatischen Lauf.</div>{% endif %}

{% macro card(c, cls='') %}
<article class="card {{ cls }}" data-rubric="{{ c.rubric }}" data-countries="{{ c.countries|map(attribute='id')|join(' ') }}">
  <div class="meta"><span class="tag">{{ c.rubric_short }}</span>{% if c.is_new %}<span class="pill new">NEU</span>{% endif %}</div>
  <h4><a class="h" href="{{ c.url }}" target="_blank" rel="noopener">{{ c.title }}</a></h4>
  {% if c.orig %}<p class="orig">Original ({{ c.lang }}): {{ c.orig }}</p>{% endif %}
  <div class="meta">
    <span>{{ c.source }}</span><span>·</span><span>{{ c.when }}</span>
    {% if c.lang != 'DE' %}<span class="pill" title="Originalsprache, automatisch übersetzt">{{ c.lang }}→DE</span>{% endif %}
    {% for k in c.countries %}<span class="pill c">{{ k.id }}</span>{% endfor %}
  </div>
  {% if c.n > 1 %}<div class="others">{{ c.n }} Quellen berichten{% if c.others %}: auch {{ c.others }}{% endif %}</div>{% endif %}
</article>
{% endmacro %}

<div class="wrap">
  <div class="topbar"><span>{{ date }}</span><span>Ausgabe Nr. {{ edition }}</span><span>Stand {{ updated }}</span></div>
  <header class="mast">
    <h1>{{ site.title.split(' ')[0] }} <span>{{ site.title.split(' ')[1:]|join(' ') }}</span></h1>
    <p>{{ site.tagline }}</p>
  </header>
</div>

<nav aria-label="Rubriken"><div class="wrap">
  <a href="#kennzahlen">Kennzahlen</a><a href="#top">Top-News</a>
  {% for s in sections %}<a href="#{{ s.id }}">{{ s.short }}</a>{% endfor %}
  <input id="q" type="search" placeholder="Suchen …" aria-label="Meldungen durchsuchen">
</div></nav>

<main class="wrap">
  {% if errors %}<div class="errors"><strong>Hinweis zu den Kennzahlen:</strong> {{ errors|join(' · ') }}</div>{% endif %}

  {% if charts %}
  <section id="kennzahlen">
    <div class="kicker"><b>★</b><h2>Kennzahlen</h2><small>Quelle: Statistisches Bundesamt (Destatis)</small></div>
    <div class="charts">
      {% for c in charts %}
      <div class="chart">
        <header>
          <div><h3>{{ c.title }}</h3><div class="sub">{{ c.sub }}</div></div>
          <div class="val"><div class="big">{{ c.latest }}</div><div class="per">{{ c.period }}</div></div>
        </header>
        <div class="deltas">
          <span>{{ c.d1|arrow }} <em>ggü. {{ c.d1_label }}</em></span>
          {% if c.d12 is not none %}<span>{{ c.d12|arrow }} <em>ggü. Vorjahr</em></span>{% endif %}
        </div>
        {{ c.svg|safe }}
        <footer>Tabelle <a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.url.split('/')[-1] }}</a> · abgerufen {{ c.fetched }}</footer>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section id="top">
    <div class="kicker"><b>★</b><h2>Top-News der Woche</h2><small>{{ n_week }} Meldungen · {{ n_today }} neu in 24 h · {{ n_src }} Quellen</small></div>
    {% if top %}
    <div class="front">
      <div class="leadwrap lead">
        {% set l = top[0] %}
        <div class="meta"><span class="tag">{{ l.rubric_short }}</span>{% if l.is_new %}<span class="pill new">NEU</span>{% endif %}</div>
        <h3><a class="h" href="{{ l.url }}" target="_blank" rel="noopener">{{ l.title }}</a></h3>
        {% if l.orig %}<p class="orig">Original ({{ l.lang }}): {{ l.orig }}</p>{% endif %}
        <div class="meta"><span>{{ l.source }}</span><span>·</span><span>{{ l.when }}</span>
          {% if l.n > 1 %}<span class="pill">{{ l.n }} Quellen</span>{% endif %}
          {% for k in l.countries %}<span class="pill c">{{ k.name }}</span>{% endfor %}</div>
        <div class="side numbered" style="margin-top:26px;border-top:3px solid var(--rule-strong);padding-top:16px">
          {% for c in top[1:] %}
          <article>
            <div class="meta"><span class="tag">{{ c.rubric_short }}</span>{% if c.is_new %}<span class="pill new">NEU</span>{% endif %}</div>
            <h4><a class="h" href="{{ c.url }}" target="_blank" rel="noopener">{{ c.title }}</a></h4>
            <div class="meta"><span>{{ c.source }}</span><span>·</span><span>{{ c.when }}</span>{% if c.n > 1 %}<span class="pill">{{ c.n }} Quellen</span>{% endif %}</div>
          </article>
          {% endfor %}
        </div>
      </div>
      <aside class="rail">
        <div class="box">
          <h3>Länder-Radar · 7 Tage</h3>
          <div class="radar">
            {% for r in radar_c %}<a href="#laender" class="{{ 'zero' if r.count == 0 }}" data-jump="{{ r.id }}" title="{{ r.latest or 'Keine Meldungen' }}"><b>{{ r.count }}</b>{{ r.name }}</a>{% endfor %}
          </div>
        </div>
        <div class="box">
          <h3>Zuschlags-Radar</h3>
          {% if zus %}<ul>{% for c in zus %}
            <li><a class="h" href="{{ c.url }}" target="_blank" rel="noopener">{{ c.title }}</a>
              <div class="meta"><span>{{ c.source }}</span><span>·</span><span>{{ c.when }}</span></div></li>
          {% endfor %}</ul>{% else %}<div class="empty">Diese Woche keine Zuschlags-Meldungen.</div>{% endif %}
        </div>
      </aside>
    </div>
    {% else %}<div class="empty">Noch keine Meldungen.</div>{% endif %}
  </section>

  {% for s in sections %}
  <section id="{{ s.id }}" data-section>
    <div class="kicker"><b>{{ s.num }}</b><h2>{{ s.title }}</h2><small>{{ s.total }} in 7 Tagen</small></div>
    {% if s.id == 'laender' %}
    <div class="chips" role="group" aria-label="Land filtern">
      <button type="button" aria-pressed="true" data-c="">Alle</button>
      {% for c in countries %}<button type="button" aria-pressed="false" data-c="{{ c.id }}">{{ c.name }}</button>{% endfor %}
    </div>
    {% endif %}
    {% if s.shown %}
    <div class="sec">
      <div>{{ card(s.shown[0], 'feat') }}</div>
      {% if s.shown|length > 1 %}<div class="rest">{% for c in s.shown[1:3] %}{{ card(c) }}{% endfor %}</div>{% endif %}
    </div>
    {% if s.shown|length > 3 or s.more %}
    <div class="grid3">{% for c in s.shown[3:] %}{{ card(c) }}{% endfor %}</div>
    {% if s.more %}<details class="more"><summary>{{ s.more|length }} weitere Meldungen</summary>
      <div class="grid3">{% for c in s.more %}{{ card(c) }}{% endfor %}</div></details>{% endif %}
    {% endif %}
    {% else %}<div class="empty">Diese Woche keine Meldungen in dieser Rubrik.</div>{% endif %}
  </section>
  {% endfor %}
</main>

<div class="wrap"><footer class="site">
  <strong>So entsteht der Seil-Report.</strong> Täglich frühmorgens werden Suchanfragen in Deutsch, Englisch, Französisch, Niederländisch, Türkisch, Arabisch und Hebräisch an Google News gestellt, nach Rubriken und Ländern sortiert, doppelte Meldungen gebündelt und die Titel maschinell ins Deutsche übersetzt. Maschinelle Übersetzungen können Fehler enthalten – im Zweifel gilt der Originaltitel.
  Kennzahlen: Statistisches Bundesamt (Destatis), GENESIS-Online. Themen, Suchbegriffe und Länder lassen sich in <code>config.yaml</code> anpassen.
</footer></div>

<script>
(function(){
  var $=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};
  var q=document.getElementById('q'), country='';
  function apply(){
    var t=(q.value||'').trim().toLowerCase();
    $('.card').forEach(function(c){
      var okT=!t||c.textContent.toLowerCase().indexOf(t)>-1;
      var inL=c.closest('#laender');
      var okC=!country||!inL||(' '+c.dataset.countries+' ').indexOf(' '+country+' ')>-1;
      c.classList.toggle('hidden',!(okT&&okC));
    });
    if(t){$('details.more').forEach(function(d){d.open=true})}
  }
  q.addEventListener('input',apply);
  function setCountry(c){country=c;$('.chips button').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.c===c)});apply()}
  $('.chips button').forEach(function(b){b.addEventListener('click',function(){setCountry(b.dataset.c)})});
  $('[data-jump]').forEach(function(a){a.addEventListener('click',function(){setCountry(a.dataset.jump)})});
})();
</script>
</body>
</html>
