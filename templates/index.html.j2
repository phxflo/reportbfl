<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="google" content="notranslate">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.tagline }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231a2b3c'/%3E%3Cpath d='M8 24 L24 8 M8 18 L18 8 M14 24 L24 14' stroke='%236ec6f5' stroke-width='2.5' stroke-linecap='round'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --steel:#1a2b3c;                 /* RAL 5011 Stahlblau */
  --paper:#f4f6f8; --card:#ffffff; --ink:#1a2b3c; --muted:#5a6a7a; --rule:#d5dce3; --chip:#e6ecf1;
  --accent:#6ec6f5; --accent-ink:#0b6fa8; --line:#1f5f93;
  --sans:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  --serif:"Source Serif 4",Georgia,"Times New Roman",serif;
}
@media (prefers-color-scheme:dark){.band{background:var(--steel)}}
@media (prefers-color-scheme:dark){:root{
  --paper:#0e1722; --card:#15222f; --ink:#e9eef3; --muted:#9fb0c0; --rule:#26384a; --chip:#1f3042;
  --accent:#7cc8f5; --accent-ink:#7cc8f5; --line:#7fb2e5;
}}

/* Rubrikfarben: ein fester Farbcode je Rubrik (immer zusätzlich mit Beschriftung) */
:root{--c-haefen:#1a8fa3;--c-kraene:#d49a1c;--c-industrie:#d1581f;--c-tiefbau:#7b5a3a;--c-projekte:#2f9e5b;--c-markt:#7c5cc4;--c-laender:#c23a55;--c-rohstoffe:#3b6fd4;
  --rt:color-mix(in srgb,var(--rc,var(--steel)) 58%,#0d1620)}
@media (prefers-color-scheme:dark){:root{--c-haefen:#4fc3d1;--c-kraene:#f0b84a;--c-industrie:#f08a5d;--c-tiefbau:#cdaa80;--c-projekte:#6fcf85;--c-markt:#b79cf0;--c-laender:#ee7b8a;--c-rohstoffe:#7f9cf0;
  --rt:var(--rc,var(--accent-ink))}}
.r-haefen{--rc:var(--c-haefen)}.r-kraene{--rc:var(--c-kraene)}.r-industrie{--rc:var(--c-industrie)}.r-tiefbau{--rc:var(--c-tiefbau)}
.r-projekte{--rc:var(--c-projekte)}.r-markt{--rc:var(--c-markt)}.r-laender{--rc:var(--c-laender)}.r-rohstoffe{--rc:var(--c-rohstoffe)}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:60px}
body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 var(--sans);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a.h:hover{color:var(--accent-ink);text-decoration:underline;text-underline-offset:3px}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
.gone{display:none!important}

.sample{background:var(--accent);color:#1a2b3c;font:600 13px/1.4 var(--sans);text-align:center;padding:8px 16px}
.errors{background:var(--card);border:1px solid var(--rule);border-left:4px solid var(--accent);font-size:14px;padding:10px 14px;margin:0 0 24px;color:var(--muted)}

/* Zeitungskopf */
.band{background:var(--card);color:var(--ink);border-bottom:1px solid var(--rule)}
.topbar{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:10px 0;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--rule)}
.mast{text-align:center;padding:20px 0 18px}
.mast h1{margin:0;font:800 clamp(38px,7vw,68px)/1.05 var(--serif);letter-spacing:-.015em}
.mast h1 span{color:var(--accent-ink)}
.mast p{margin:10px auto 0;font-size:14px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);display:flex;gap:14px;align-items:center;justify-content:center}
.mast p::before,.mast p::after{content:"";flex:1;max-width:120px;border-top:1px solid var(--rule)}
.band::after{content:"";display:block;height:4px;background:var(--accent)}

nav{position:sticky;top:0;z-index:10;background:var(--paper);border-bottom:1px solid var(--rule);margin-bottom:30px}
nav .wrap{display:flex;gap:0;align-items:center;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;scroll-snap-type:x proximity}
nav .wrap::-webkit-scrollbar{display:none}
nav a{font-size:13px;font-weight:600;padding:14px 7px;white-space:nowrap;color:var(--muted);scroll-snap-align:center;flex:none}
@media (max-width:1099px){nav{-webkit-mask-image:linear-gradient(90deg,#000 calc(100% - 28px),transparent);mask-image:linear-gradient(90deg,#000 calc(100% - 28px),transparent)}}
nav a:hover{color:var(--accent-ink)}
nav a.rc{border-bottom:3px solid color-mix(in srgb,var(--rc) 45%,transparent);display:flex;align-items:center;gap:5px}
nav a.rc:hover{color:var(--ink);border-bottom-color:var(--rc)}
nav a.rc b{font:700 12px var(--sans);color:var(--rt);font-variant-numeric:tabular-nums}
nav .sep{width:1px;height:20px;background:var(--rule);margin:0 6px;flex:none}
nav input{margin-left:auto;font:14px var(--sans);padding:7px 14px;border:1px solid var(--rule);border-radius:99px;background:var(--card);color:var(--ink);min-width:150px}

#trbar{background:var(--card);border:1px solid var(--rule);border-left:4px solid var(--accent);padding:10px 14px;margin:-8px 0 24px;font-size:14px;display:flex;gap:12px;align-items:center;flex-wrap:wrap}
#trbar[hidden]{display:none}
#trbar button{font:600 13px var(--sans);padding:7px 14px;border:0;border-radius:6px;background:var(--steel);color:#fff;cursor:pointer}
#trbar span{color:var(--muted)}

/* Rubrikköpfe im Zeitungsstil */
h2.kicker{display:flex;align-items:baseline;gap:12px;margin:0;padding:12px 22px 10px;font:700 26px/1.2 var(--serif);letter-spacing:-.005em;border-top:6px solid var(--rc,var(--steel));border-bottom:1px solid var(--rule);background:var(--card)}
.grouphead{display:flex;align-items:center;gap:14px;margin:48px 0 6px;font:700 22px/1.2 var(--serif);color:var(--ink)}
.grouphead::after{content:"";flex:1;height:1px;background:var(--rule)}
.grouphead .sws{display:flex;gap:4px}.grouphead .sws i{width:14px;height:14px;border-radius:3px;background:var(--rc)}
h2.kicker small{font:500 13px var(--sans);color:var(--muted);margin-left:auto;white-space:nowrap}
h2.kicker i{width:14px;height:14px;border-radius:3px;background:var(--rc,var(--accent));align-self:center;flex:none;font-size:0}
section{margin-bottom:38px}
.box{background:var(--card);border:1px solid var(--rule);border-top:0}

/* Kennzahlen */
section#kennzahlen h2.kicker{border:0;background:none;padding:0 0 12px}
.charts{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin:0 -20px;padding:0 20px 4px;scroll-padding:0 20px}
.charts::-webkit-scrollbar{display:none}
.charts .chart{flex:0 0 min(86%,420px);scroll-snap-align:start}
.swipe{display:none;font-size:12px;color:var(--muted);margin:-6px 0 10px}
@media (max-width:899px){.swipe{display:block}}
@media (min-width:900px){.charts{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;overflow:visible;margin:0;padding:0}.charts .chart{flex:none}}
.chart{background:var(--card);border:1px solid var(--rule);border-top:5px solid var(--steel);padding:16px 18px 10px}
.chart header{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.chart h3{margin:0;font:700 17px/1.3 var(--serif)}
.chart .sub{font-size:12px;color:var(--muted);margin-top:2px}
.chart .val{text-align:right;flex:none}
.chart .big{font:800 32px/1 var(--serif);letter-spacing:-.01em}
.chart .per{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-top:2px}
.deltas{display:flex;gap:16px;font-size:13px;font-weight:600;margin:8px 0 4px;flex-wrap:wrap}
.deltas span em{font-style:normal;font-weight:400;color:var(--muted)}
.chart svg{width:100%;height:auto;display:block;overflow:visible}
.chart text{font:10.5px var(--sans);fill:var(--muted)}
.chart .grid{stroke:var(--rule);stroke-width:1}
.chart .line{fill:none;stroke:var(--line);stroke-width:2.4;stroke-linejoin:round;stroke-linecap:round}
.chart .area{fill:var(--line);opacity:.1}
.chart .dot{fill:var(--accent);stroke:var(--card);stroke-width:2}
.chart .hit{fill:transparent}
.chart .hit:hover{fill:rgba(110,198,245,.35)}
.chart footer{font-size:11px;color:var(--muted);padding:2px 0 4px}
.chart footer a{text-decoration:underline}

/* Bausteine */
.meta{font-size:13px;color:var(--muted);display:flex;flex-wrap:wrap;gap:4px 8px;align-items:center}
.pill{font-size:11px;font-weight:600;padding:2px 7px;border-radius:99px;background:var(--chip);color:var(--ink);white-space:nowrap}
.pill.hot{background:transparent;border:1px solid var(--c-laender);color:var(--c-laender);font-weight:700}
.pill.new{background:var(--accent);color:#1a2b3c}
.pill.c{background:transparent;border:1px solid var(--rule);color:var(--ink);font-weight:600}
.pill.t{background:transparent;border:1px solid var(--accent-ink);color:var(--accent-ink)}
.tag{font-size:12px;font-weight:700;color:var(--rt);display:inline-flex;align-items:center;gap:6px}
.tag::before{content:"";width:9px;height:9px;border-radius:2px;background:var(--rc,var(--accent));flex:none}
.tr::after{content:" ⇄";font-size:.7em;color:var(--muted)}
.x{border:0;background:none;color:var(--muted);font-size:13px;line-height:1;padding:4px 6px;border-radius:4px;cursor:pointer;opacity:.35;flex:none;align-self:flex-start}
.x:hover,.x:focus-visible{opacity:1;background:var(--chip)}

/* Titelseite */
.rank{list-style:none;margin:0;padding:0;counter-reset:n;background:var(--card);border:1px solid var(--rule);border-top:0}
.rank li{counter-increment:n;display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:0 10px;align-items:start;padding:16px 20px 16px 16px;border-top:1px solid var(--rule);border-left:5px solid var(--rc,var(--rule))}
.rank li:first-child{border-top:0}
.rank li::before{content:counter(n);font:800 30px/1 var(--serif);color:var(--rt);text-align:center;padding-top:2px}
.rank .h{display:block;font:700 20px/1.3 var(--serif);margin:4px 0 6px}
.rank li:first-child .h{font-size:24px}

/* Rubriken */
.rows{columns:2 360px;column-gap:44px;padding:4px 22px 14px}
.row{display:grid;grid-template-columns:62px minmax(0,1fr) auto;gap:12px;padding:12px 0;border-top:1px solid var(--rule);break-inside:avoid}
.when{font-size:12px;line-height:1.4;color:var(--muted);padding-top:3px;font-variant-numeric:tabular-nums}
.row .h{font-size:16px;font-weight:600;line-height:1.4}
.row .meta{margin-top:3px;font-size:12.5px}
.empty{font-size:15px;color:var(--muted);padding:14px 22px}
.chips{display:flex;gap:6px;flex-wrap:wrap;padding:14px 22px 0}
.chips button{font:600 13px var(--sans);padding:6px 13px;border:1px solid var(--rule);background:var(--card);color:var(--ink);border-radius:99px;cursor:pointer}
.chips button[aria-pressed=true]{background:var(--rc,var(--steel));color:#fff;border-color:var(--rc,var(--steel))}
.hidden{display:none!important}

.health{margin:0 0 14px;font-size:13px}
.health summary{cursor:pointer;color:var(--muted);list-style:none}
.health summary::-webkit-details-marker{display:none}
.health .dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:7px;vertical-align:baseline;background:var(--ok,#2e9d5b)}
.health .warn .dot,.health .dot.warn{background:#d99a1c}.health .bad .dot,.health .dot.bad{background:#d23b4a}
.health ul{list-style:none;margin:8px 0 0;padding:0}.health li{padding:2px 0;color:var(--muted)}.health li b{color:var(--ink);font-weight:600;margin-right:6px}
.healthbar{background:color-mix(in srgb,#d23b4a 14%,var(--card));border-bottom:1px solid #d23b4a;color:var(--ink);font-size:13px;padding:8px 16px;text-align:center}
footer.site{border-top:1px solid var(--rule);padding:22px 0 48px;font-size:13px;line-height:1.65;color:var(--muted)}
footer.site strong{color:var(--ink)}
footer.site button{font:600 12px var(--sans);border:1px solid var(--rule);background:var(--card);color:var(--ink);border-radius:6px;padding:4px 10px;cursor:pointer;margin-right:6px}

@media (max-width:760px){
}
@media (max-width:600px){
  body{font-size:15.5px}.wrap{padding:0 16px}
  .rows{columns:1;padding:4px 16px 10px}.row{grid-template-columns:54px minmax(0,1fr) auto;gap:10px}
  nav input{display:none}h2.kicker{padding:10px 16px 8px;font-size:22px}h2.kicker small{display:none}
  .chart .big{font-size:26px}.rank li{grid-template-columns:30px minmax(0,1fr) auto;padding:14px 12px 14px 12px}.rank li::before{font-size:24px}.rank .h{font-size:18px}.rank li:first-child .h{font-size:20px}
  .chips{padding:12px 16px 0}.mast p::before,.mast p::after{display:none}
}
@media print{nav,.chips,#trbar,.x{display:none}body{background:#fff}}
</style>
</head>
<body>
{% if health|selectattr(1,'equalto','bad')|list %}<div class="healthbar">Störung bei der heutigen Aktualisierung – Details unten im Systemstatus.</div>{% endif %}
{% if sample %}<div class="sample">VORSCHAU MIT BEISPIELDATEN – Überschriften, Quellen und Zahlen sind erfunden. Echte Meldungen erscheinen nach dem ersten automatischen Lauf.</div>{% endif %}

{% macro item(c) %}<a dir="auto" class="h" href="{{ c.url }}" target="_blank" rel="noopener"{% if c.orig %} title="Original: {{ c.orig }}"{% endif %}{% if c.needs_tr %} data-t="1" data-lang="{{ c.lang|lower }}"{% endif %}>{{ c.title }}</a>{% endmacro %}

{% macro badges(c) %}{% if c.trusted %}<span>·</span><span>Fachmedium</span>{% endif %}{% if c.n > 1 %}<span>·</span><span>{{ c.n }} Quellen</span>{% endif %}{% endmacro %}

{% macro chips(c) %}{% for k in c.countries %}<span class="pill c">{{ k.name }}</span>{% endfor %}{% if c.is_new %}<span class="pill new">NEU</span>{% endif %}{% if c.bris is defined and c.bris >= 5 %}<span class="pill hot">Brisant</span>{% endif %}{% endmacro %}

{% macro hot(c) %}{% if c.bris is defined and c.bris >= 5 %}<span class="pill hot">Brisant</span>{% endif %}{% endmacro %}

{% macro xbtn() %}<button class="x" type="button" title="Meldung ausblenden" aria-label="Meldung ausblenden">✕</button>{% endmacro %}

{% macro row(c, hide=false) %}
<article class="row{{ ' hidden' if hide }}" data-id="{{ c.id }}" data-countries="{{ c.countries|map(attribute='id')|join(' ') }}">
  <div class="when">{{ c.when }}</div>
  <div>{% if c.countries or c.is_new or (c.bris is defined and c.bris >= 5) %}<div class="meta" style="margin-bottom:4px">{{ chips(c) }}</div>{% endif %}{{ item(c) }}<div class="meta"><span>{{ c.source }}</span>{{ badges(c) }}</div></div>
  {{ xbtn() }}
</article>
{% endmacro %}

<header class="band"><div class="wrap">
  <div class="topbar"><span>{{ date }}</span><span>Stand {{ updated }}</span></div>
  <div class="mast">
    <h1>{{ site.title.split(' ')[0] }} <span>{{ site.title.split(' ')[1:]|join(' ') }}</span></h1>
    <p>{{ site.tagline }}</p>
  </div>
</div></header>

<nav aria-label="Rubriken"><div class="wrap">
  <a href="#kennzahlen">Kennzahlen</a><a href="#top">Top-5</a><span class="sep"></span>
  {% for s in sections %}<a class="rc r-{{ s.id }}" href="#{{ s.id }}">{{ s.short }}{% if s.shown %}<b class="has">{{ s.shown|length }}</b>{% endif %}</a>{% endfor %}
  <input id="q" type="search" placeholder="Suchen …" aria-label="Meldungen durchsuchen">
</div></nav>

<main class="wrap">
  {% if errors %}<div class="errors"><strong>Hinweis zu den Kennzahlen:</strong> {{ errors|join(' · ') }}</div>{% endif %}

  {% if charts %}
  <section id="kennzahlen">
    <h2 class="kicker">Kennzahlen<small>Quelle: Statistisches Bundesamt (Destatis)</small></h2>
    <div class="charts">
      {% for c in charts %}
      <div class="chart">
        <header>
          <div><h3>{{ c.title }}</h3><div class="sub">{{ c.sub }}</div></div>
          <div class="val"><div class="big">{{ c.latest }}</div><div class="per">{{ c.period }}</div></div>
        </header>
        <div class="deltas">
          {% if c.d1 is not none %}<span>{{ c.d1|arrow }} <em>ggü. {{ c.d1_label }}</em></span>{% endif %}
          {% if c.note %}<span>{{ c.note }}</span>{% endif %}
          {% if c.d12 is not none %}<span>{{ c.d12|arrow }} <em>ggü. Vorjahr</em></span>{% endif %}
        </div>
        {{ c.svg|safe }}
        <footer>Tabelle <a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.url.split('/')[-1] }}</a> · abgerufen {{ c.fetched }}</footer>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section id="top">
    <h2 class="kicker">Top-5 der Woche</h2>
    {% if top %}
    <ol class="rank">
      {% for c in top %}
      <li class="r-{{ c.rubric }}" data-id="{{ c.id }}">
        <div style="grid-column:2">
          <div class="meta"><span class="tag">{{ c.rubric_short }}</span>{{ chips(c) }}</div>
          {{ item(c) }}
          <div class="meta"><span>{{ c.source }}</span><span>·</span><span>{{ c.when }}</span>{{ badges(c) }}</div>
        </div>
        {{ xbtn() }}
      </li>
      {% endfor %}
    </ol>
    {% else %}<div class="box"><div class="empty">Noch keine Meldungen.</div></div>{% endif %}
  </section>

  {% for s in sections %}
  {% if s.group and (loop.first or sections[loop.index0 - 1].group != s.group) %}<div class="grouphead">{{ s.group }}</div>{% endif %}
  <section id="{{ s.id }}" class="r-{{ s.id }}" data-section>
    <h2 class="kicker"><i></i>{{ s.title }}</h2>
    <div class="box">
    {% if s.shown %}
    <div class="rows">{% for c in s.shown %}{{ row(c) }}{% endfor %}</div>
    {% else %}<div class="empty">Nichts Neues in den letzten 7 Tagen.</div>{% endif %}
    </div>
  </section>
  {% endfor %}
</main>

<div class="wrap"><footer class="site">
  <div id="hidebar" hidden><button id="hidecopy" type="button">Ausgeblendete Titel kopieren</button><button id="hidereset" type="button">Alle wieder einblenden</button><span id="hidecount"></span></div>
  {% set lvl = 'bad' if health|selectattr(1,'equalto','bad')|list else ('warn' if health|selectattr(1,'equalto','warn')|list else 'ok') %}
  <details class="health"><summary><span class="dot {{ lvl }}"></span>Systemstatus: {{ 'alles in Ordnung' if lvl == 'ok' else 'Hinweise beachten' if lvl == 'warn' else 'Störung – Inhalte evtl. unvollständig' }}</summary>
    <ul>{% for n, s, x in health %}<li class="{{ s }}"><span class="dot {{ s }}"></span><b>{{ n }}</b>{{ x }}</li>{% endfor %}</ul></details>
  Quelle der Kennzahlen: Statistisches Bundesamt (Destatis), GENESIS-Online.
</footer></div>

<script>
(function(){
  var $=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};
  var q=document.getElementById('q');

  /* Suche */
  function apply(){
    var t=(q.value||'').trim().toLowerCase();
    $('section[data-section] .row').forEach(function(r){
      r.classList.toggle('hidden',!!t&&r.textContent.toLowerCase().indexOf(t)<0);
    });
  }
  q.addEventListener('input',apply);

  /* Ausblenden (nur in diesem Browser) */
  var hid={}; try{hid=JSON.parse(localStorage.getItem('seilHide')||'{}')}catch(e){}
  var cut=Date.now()-45*864e5; Object.keys(hid).forEach(function(k){if(hid[k].t<cut)delete hid[k]});
  function saveHid(){try{localStorage.setItem('seilHide',JSON.stringify(hid))}catch(e){}}
  function applyHid(){
    $('[data-id]').forEach(function(el){el.classList.toggle('gone',!!hid[el.dataset.id])});
    var n=Object.keys(hid).length, bar=document.getElementById('hidebar');
    bar.hidden=!n; document.getElementById('hidecount').textContent=n?n+' ausgeblendet':''; apply();
  }
  document.addEventListener('click',function(e){
    var b=e.target.closest&&e.target.closest('.x'); if(!b)return;
    var el=b.closest('[data-id]'); if(!el)return;
    var a=el.querySelector('a.h'); hid[el.dataset.id]={t:Date.now(),s:(a?a.textContent.trim():'').slice(0,160),u:a?a.href:''};
    saveHid(); applyHid();
  });
  document.getElementById('hidereset').addEventListener('click',function(){hid={};saveHid();applyHid()});
  document.getElementById('hidecopy').addEventListener('click',function(){
    var txt=Object.keys(hid).map(function(k){return hid[k].s+'  '+hid[k].u}).join('\n');
    try{navigator.clipboard.writeText(txt);document.getElementById('hidecount').textContent='Liste kopiert'}catch(e){}
  });
  applyHid();

  /* Reste (falls die Übersetzung im Lauf nicht geklappt hat): stillschweigend mit der Browser-Übersetzung, falls schon installiert */
  var pending=$('[data-t]'); if(!pending.length||!('Translator' in self)) return;
  var cache={}; try{cache=JSON.parse(localStorage.getItem('seilTr')||'{}')}catch(e){}
  (async function(){
    for(var el of pending){
      var lang=el.dataset.lang, o=el.textContent.trim(), k=lang+'|'+o, t=cache[k];
      if(!t){
        try{
          var opt={sourceLanguage:lang,targetLanguage:'de'};
          if(await Translator.availability(opt)!=='available') continue;
          t=await (await Translator.create(opt)).translate(o); cache[k]=t;
        }catch(e){continue}
      }
      el.title='Original: '+o; el.textContent=t; el.classList.add('tr'); el.removeAttribute('data-t');
    }
    try{if(Object.keys(cache).length>1500)cache={};localStorage.setItem('seilTr',JSON.stringify(cache))}catch(e){}
  })();
})();
</script>
</body>
</html>
