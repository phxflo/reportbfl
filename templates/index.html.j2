<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="google" content="notranslate">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.tagline }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231a2b3c'/%3E%3Cpath d='M8 24 L24 8 M8 18 L18 8 M14 24 L24 14' stroke='%236ec6f5' stroke-width='2.5' stroke-linecap='round'/%3E%3C/svg%3E">
<style>
{{ fontcss|safe }}
:root{
  --steel:#1b3552;
  --paper:#f2f4f7; --card:#fff; --ink:#0f1a24; --muted:#5d6b79; --rule:#e1e6ec; --chip:#e9edf2;
  --accent:#e3a21a; --accent-ink:#8a5a00; --line:#1f4f7e; --mark:#1b3552;
  --r:14px;
  --sans:"Barlow",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
}
@media (prefers-color-scheme:dark){:root{
  --paper:#0d1117; --card:#151b23; --ink:#e8edf1; --muted:#93a1af; --rule:#242d38; --chip:#202a35;
  --accent:#f2b53f; --accent-ink:#f2b53f; --line:#7fb2e5; --mark:#9db8d3;
}}

/* Rubrikfarben: ein fester Farbcode je Rubrik (immer zusätzlich mit Beschriftung) */
:root{--c-haefen:#1a8fa3;--c-kraene:#d49a1c;--c-industrie:#d1581f;--c-tiefbau:#7b5a3a;--c-markt:#7c5cc4;--c-laender:#c23a55;--c-rohstoffe:#3b6fd4;
  --rt:color-mix(in srgb,var(--rc,var(--steel)) 58%,#0d1620)}
@media (prefers-color-scheme:dark){:root{--c-haefen:#4fc3d1;--c-kraene:#f0b84a;--c-industrie:#f08a5d;--c-tiefbau:#cdaa80;--c-markt:#b79cf0;--c-laender:#ee7b8a;--c-rohstoffe:#7f9cf0;
  --rt:var(--rc,var(--accent-ink))}}
.r-haefen{--rc:var(--c-haefen)}.r-kraene{--rc:var(--c-kraene)}.r-industrie{--rc:var(--c-industrie)}.r-tiefbau{--rc:var(--c-tiefbau)}
.r-markt{--rc:var(--c-markt)}.r-laender{--rc:var(--c-laender)}.r-rohstoffe{--rc:var(--c-rohstoffe)}
.r-haefen,.r-kraene,.r-industrie,.r-tiefbau,.r-markt,.r-laender,.r-rohstoffe{--rt:color-mix(in srgb,var(--rc) 58%,#0d1620)}
@media (prefers-color-scheme:dark){.r-haefen,.r-kraene,.r-industrie,.r-tiefbau,.r-markt,.r-laender,.r-rohstoffe{--rt:var(--rc)}}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:76px}
body{margin:0;background:var(--paper);color:var(--ink);font:16.5px/1.5 var(--sans);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a.h:hover{color:var(--accent-ink);text-decoration:underline;text-underline-offset:3px}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
.gone{display:none!important}

.sample{background:var(--accent);color:#1a1200;font:600 13px/1.4 var(--sans);text-align:center;padding:8px 16px}
.errors{background:var(--card);border:1px solid var(--rule);border-left:4px solid var(--accent);font-size:14px;padding:10px 14px;margin:0 0 24px;color:var(--muted)}

/* Kopf */
.top{display:flex;align-items:center;gap:14px;padding-top:22px;padding-bottom:18px}
.top .mark{width:46px;height:46px;flex:none}
.top h1{margin:0;font:800 30px/1 var(--sans);letter-spacing:-.02em}
.top h1 span{color:var(--accent-ink)}
.top p{margin:5px 0 0;font-size:14px;color:var(--muted)}
.top .stand{margin-left:auto;text-align:right;font-size:13px;line-height:1.5;color:var(--muted)}

/* Navigation: bleibt oben stehen und markiert den Bereich, in dem man gerade liest */
nav{position:sticky;top:0;z-index:10;background:color-mix(in srgb,var(--paper) 86%,transparent);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-bottom:1px solid var(--rule);margin-bottom:28px}
nav .wrap{display:flex;gap:4px;align-items:center;padding-top:9px;padding-bottom:9px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
nav .wrap::-webkit-scrollbar{display:none}
nav a{display:flex;align-items:center;gap:7px;flex:none;font-size:14px;font-weight:600;padding:7px 13px;border-radius:99px;white-space:nowrap;color:var(--muted);transition:background .15s,color .15s}
nav a:hover{color:var(--ink);background:var(--chip)}
nav a::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--rc,var(--muted));opacity:.85}
nav a.on{color:var(--ink);background:color-mix(in srgb,var(--rc,var(--accent)) 20%,var(--card));box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--rc,var(--accent)) 45%,transparent)}
nav a b{font-size:12px;font-weight:700;color:var(--muted);font-variant-numeric:tabular-nums}
nav a.on b{color:var(--ink)}
nav .sep{width:1px;height:20px;background:var(--rule);margin:0 6px;flex:none}

/* Rubrikköpfe */
h2.kicker{display:flex;align-items:center;gap:10px;margin:0 0 12px;font:700 21px/1.2 var(--sans);letter-spacing:-.01em}
h2.kicker small{font:500 13px var(--sans);color:var(--muted);margin-left:auto;white-space:nowrap}
h2.kicker i{width:10px;height:10px;border-radius:50%;background:var(--rc,var(--accent));flex:none;font-size:0}
.grouphead{margin:44px 0 14px;font:700 14px/1.2 var(--sans);color:var(--muted);letter-spacing:.02em}
section{margin-bottom:34px}
.box{background:var(--card);border:1px solid var(--rule);border-radius:var(--r);overflow:hidden}

/* Kennzahlen */
.charts{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin:0 -20px;padding:0 20px 4px;scroll-padding:0 20px}
.charts::-webkit-scrollbar{display:none}
.charts .chart{flex:0 0 min(86%,420px);scroll-snap-align:start}
@media (min-width:900px){.charts{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;overflow:visible;margin:0;padding:0}.charts .chart{flex:none}}
.chart{background:var(--card);border:1px solid var(--rule);border-radius:var(--r);padding:18px 20px 10px}
.chart header{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.chart h3{margin:0;font:700 17px/1.25 var(--sans)}
.chart .sub{font-size:12.5px;color:var(--muted);margin-top:2px}
.chart .val{text-align:right;flex:none}
.chart .big{font:800 38px/1 var(--sans);letter-spacing:-.02em}
.chart .per{font-size:12px;color:var(--muted);margin-top:3px}
.deltas{display:flex;gap:16px;font-size:13px;font-weight:600;margin:8px 0 4px;flex-wrap:wrap}
.deltas span em{font-style:normal;font-weight:400;color:var(--muted)}
.chart svg{width:100%;height:auto;display:block;overflow:visible}
.chart text{font:10.5px var(--sans);fill:var(--muted)}
.chart .grid{stroke:var(--rule);stroke-width:1}
.chart .line{fill:none;stroke:var(--line);stroke-width:2.4;stroke-linejoin:round;stroke-linecap:round}
.chart .area{fill:var(--line);opacity:.1}
.chart .dot{fill:var(--accent);stroke:var(--card);stroke-width:2}
.chart .hit{fill:transparent}
.chart .hit:hover{fill:rgba(227,162,26,.35)}
.chart footer{font-size:11px;color:var(--muted);padding:2px 0 4px}
.chart footer a{text-decoration:underline}

/* Bausteine */
.meta{font-size:13px;color:var(--muted);display:flex;flex-wrap:wrap;gap:4px 8px;align-items:center}
.bericht{margin-top:8px;font-size:14px;line-height:1.5}
.bericht summary{cursor:pointer;color:var(--accent-ink);font-weight:600;font-size:13px;list-style:none}
.bericht summary::-webkit-details-marker{display:none}
.bericht summary::before{content:"+ ";font-weight:700}
.bericht[open] summary::before{content:"– "}
.bericht p{margin:6px 0 4px;max-width:62ch}
.bq{display:flex;flex-wrap:wrap;gap:2px 12px;font-size:12.5px}
.bq a{color:var(--muted);text-decoration:underline;text-underline-offset:2px}
.pill{font-size:11px;font-weight:600;padding:2px 7px;border-radius:99px;background:var(--chip);color:var(--ink);white-space:nowrap}
.pill.new{background:var(--accent);color:#1a1200}
.cty{font-size:13px;font-weight:600;color:var(--muted);white-space:normal}
.pill.t{background:transparent;border:1px solid var(--accent-ink);color:var(--accent-ink)}
.pill.k{background:var(--steel);color:#fff;border:1px solid color-mix(in srgb,#fff 25%,var(--steel))}
.rate{display:inline-flex;gap:7px;flex:none;align-self:flex-start;margin:5px 2px 0 0}
.rb{box-sizing:border-box;width:15px;height:15px;border-radius:50%;border:2px solid var(--rb);background:transparent;padding:0;cursor:pointer;opacity:.5;position:relative}
.rb::after{content:"";position:absolute;inset:-6px}
.rb.g{--rb:#2f9e5b}.rb.y{--rb:#d9961a}.rb.r{--rb:#d23b4a}
.rb:hover,.rb:focus-visible{opacity:1}
.rb.sel{background:var(--rb);opacity:1}
@media (max-width:600px){.rate{gap:9px}.rb{width:17px;height:17px}}

/* Titelseite */

/* Rubriken */
.rows{columns:2 360px;column-gap:44px;padding:2px 22px 8px}
.tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 22px;align-items:stretch;margin-bottom:34px}
.tiles section{margin:0;display:flex;flex-direction:column;min-width:0}.tiles .box{flex:1}
.tiles .rows{columns:1}
.row{display:grid;grid-template-columns:58px minmax(0,1fr) auto;gap:12px;padding:14px 0;break-inside:avoid}
.when{font-size:12px;line-height:1.4;color:var(--muted);padding-top:3px;font-variant-numeric:tabular-nums}
.row .h{font-size:16px;font-weight:600;line-height:1.4;letter-spacing:-.005em}
.row .meta{margin-top:3px;font-size:12.5px}
.empty{font-size:15px;color:var(--muted);padding:16px 22px}
.chips{display:flex;gap:6px;flex-wrap:wrap;padding:14px 22px 0}
.chips button{font:600 13px var(--sans);padding:6px 13px;border:1px solid var(--rule);background:var(--card);color:var(--ink);border-radius:99px;cursor:pointer}
.chips button[aria-pressed=true]{background:var(--rc,var(--steel));color:#fff;border-color:var(--rc,var(--steel))}
.hidden{display:none!important}

.health{margin:0 0 14px;font-size:13px}
.health summary{cursor:pointer;color:var(--muted);list-style:none}
.health summary::-webkit-details-marker{display:none}
.health .dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:7px;vertical-align:baseline;background:var(--ok,#2e9d5b)}
.health .warn .dot,.health .dot.warn{background:#d99a1c}.health .bad .dot,.health .dot.bad{background:#d23b4a}
.health ul{list-style:none;margin:8px 0 0;padding:0}.health li{padding:2px 0;color:var(--muted)}.health li b{color:var(--ink);font-weight:600;margin-right:6px}
.healthbar{background:color-mix(in srgb,#d23b4a 14%,var(--card));border-bottom:1px solid #d23b4a;color:var(--ink);font-size:13px;padding:8px 16px;text-align:center}
footer.site{border-top:1px solid var(--rule);padding:22px 0 48px;font-size:13px;line-height:1.65;color:var(--muted)}
footer.site strong{color:var(--ink)}
footer.site button{font:600 12px var(--sans);border:1px solid var(--rule);background:var(--card);color:var(--ink);border-radius:8px;padding:5px 11px;cursor:pointer;margin-right:6px}

@media (max-width:600px){
  body{font-size:16px}.wrap{padding:0 16px}
  .tiles{grid-template-columns:1fr;gap:0}.tiles section{margin-bottom:30px}
  .rows{columns:1;padding:4px 16px 10px}.row{grid-template-columns:54px minmax(0,1fr) auto;gap:10px}
  h2.kicker small{display:none}.top .stand{display:none}.top h1{font-size:26px}.top .mark{width:40px;height:40px}
  .chart .big{font-size:32px}
}
@media print{nav,.chips,</style>
</head>
<body>
{% if health|selectattr(1,'equalto','bad')|list %}<div class="healthbar">Störung bei der heutigen Aktualisierung – Details unten im Systemstatus.</div>{% endif %}
{% if sample %}<div class="sample">VORSCHAU MIT BEISPIELDATEN – Überschriften, Quellen und Zahlen sind erfunden. Echte Meldungen erscheinen nach dem ersten automatischen Lauf.</div>{% endif %}

{% macro item(c) %}<a dir="auto" class="h" href="{{ c.url }}" target="_blank" rel="noopener"{% if c.orig %} title="Original: {{ c.orig }}"{% endif %}>{{ c.title }}</a>{% endmacro %}

{% macro badges(c) %}{% if c.trusted %}<span>·</span><span>Fachmedium</span>{% endif %}{% if c.n > 1 %}<span>·</span><span>{{ c.n }} Quellen</span>{% endif %}{% endmacro %}

{% macro chips(c) %}{% if c.countries %}<span class="cty">{{ c.countries|map(attribute="name")|join(", ") }}</span>{% endif %}{% if c.is_new %}<span class="pill new">NEU</span>{% endif %}{% if c.kunde %}<span class="pill k">Kunde</span>{% endif %}{% endmacro %}

{% macro xbtn() %}<span class="rate" role="group" aria-label="Bewertung"><button class="rb g" type="button" data-r="g" title="Gut" aria-label="Gut"></button><button class="rb y" type="button" data-r="y" title="Grenzwertig" aria-label="Grenzwertig"></button><button class="rb r" type="button" data-r="r" title="Schlecht – ausblenden" aria-label="Schlecht, ausblenden"></button></span>{% endmacro %}

{% macro bericht(c) %}{% if c.bericht %}<details class="bericht"><summary>Hintergrund</summary><p>{{ c.bericht.text }}</p>{% if c.bericht.quellen %}<div class="bq">{% for q in c.bericht.quellen %}<a href="{{ q.u }}" target="_blank" rel="noopener noreferrer">{{ q.t }}</a>{% endfor %}</div>{% endif %}</details>{% endif %}{% endmacro %}
{% macro row(c, hide=false) %}
<article class="row{{ ' hidden' if hide }}" data-id="{{ c.id }}" data-rate="{{ c.rate or '' }}">
  <div class="when">{{ c.when }}</div>
  <div>{% if c.countries or c.is_new or c.kunde %}<div class="meta" style="margin-bottom:4px">{{ chips(c) }}</div>{% endif %}{{ item(c) }}<div class="meta"><span>{{ c.source }}</span>{{ badges(c) }}</div>{{ bericht(c) }}</div>
  {{ xbtn() }}
</article>
{% endmacro %}

<header class="wrap top">
  <svg class="mark" viewBox="0 0 64 64" role="img" aria-label="Querschnitt eines Drahtseils"><g stroke="var(--card)" stroke-width="2">{% for k in range(6) %}<circle cx="{{ (32 + 20.5 * [0, 0.866, 0.866, 0, -0.866, -0.866][k])|round(1) }}" cy="{{ (32 - 20.5 * [1, 0.5, -0.5, -1, -0.5, 0.5][k])|round(1) }}" r="10.5" fill="var(--mark)"/>{% endfor %}<circle cx="32" cy="32" r="10" fill="var(--accent)"/></g><g fill="var(--card)" opacity=".35">{% for k in range(6) %}<circle cx="{{ (32 + 20.5 * [0, 0.866, 0.866, 0, -0.866, -0.866][k])|round(1) }}" cy="{{ (32 - 20.5 * [1, 0.5, -0.5, -1, -0.5, 0.5][k])|round(1) }}" r="3.4"/>{% endfor %}</g></svg>
  <div><h1>{{ site.title.split(' ')[0] }} <span>{{ site.title.split(' ')[1:]|join(' ') }}</span></h1>
  <p>{{ site.tagline }}</p></div>
  <div class="stand">{{ date }}<br>Stand {{ updated }}</div>
</header>

<nav aria-label="Rubriken"><div class="wrap">
  <a href="#kennzahlen">Kennzahlen</a><span class="sep"></span>
  {% for s in sections %}{% if not s.tile %}<a class="rc r-{{ s.id }}" href="#{{ s.id }}">{{ s.short }}{% if s.shown %}<b class="has">{{ s.shown|length }}</b>{% endif %}</a>
  {%- elif loop.first or not sections[loop.index0 - 1].tile %}{% set n = sections|selectattr('tile')|map(attribute='shown')|map('length')|sum %}<a href="#zielmaerkte">{{ s.group }}{% if n %}<b class="has">{{ n }}</b>{% endif %}</a>{% endif %}{% endfor %}
</div></nav>

<main class="wrap">
  {% if errors %}<div class="errors"><strong>Hinweis zu den Kennzahlen:</strong> {{ errors|join(' · ') }}</div>{% endif %}

  {% if charts %}
  <section id="kennzahlen">
    <h2 class="kicker">Kennzahlen<small>Quelle: Statistisches Bundesamt (Destatis)</small></h2>
    <div class="charts">
      {% for c in charts %}
      <div class="chart">
        <header>
          <div><h3>{{ c.title }}</h3><div class="sub">{{ c.sub }}</div></div>
          <div class="val"><div class="big">{{ c.latest }}</div><div class="per">{{ c.period }}</div></div>
        </header>
        <div class="deltas">
          {% if c.d1 is not none %}<span>{{ c.d1|arrow }} <em>ggü. {{ c.d1_label }}</em></span>{% endif %}
          {% if c.note %}<span>{{ c.note }}</span>{% endif %}
          {% if c.d12 is not none %}<span>{{ c.d12|arrow }} <em>ggü. Vorjahr</em></span>{% endif %}
        </div>
        {{ c.svg|safe }}
        <footer>Tabelle <a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.url.split('/')[-1] }}</a> · abgerufen {{ c.fetched }}</footer>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}


  {% for s in sections %}
  {% if s.group and (loop.first or sections[loop.index0 - 1].group != s.group) %}<div class="grouphead"{% if s.tile %} id="zielmaerkte"{% endif %}>{{ s.group }}</div>{% endif %}
  {% if s.tile and (loop.first or not sections[loop.index0 - 1].tile) %}<div class="tiles">{% endif %}
  <section id="{{ s.id }}" class="r-{{ s.id }}" data-section>
    <h2 class="kicker"><i></i>{{ s.title }}</h2>
    <div class="box">
    {% if s.shown %}
    <div class="rows">{% for c in s.shown %}{{ row(c) }}{% endfor %}</div>
    {% else %}<div class="empty">Nichts Neues in den letzten 7 Tagen.</div>{% endif %}
    </div>
  </section>
  {% if s.tile and (loop.last or not sections[loop.index0 + 1].tile) %}</div>{% endif %}
  {% endfor %}
</main>

<div class="wrap"><footer class="site">
  {% if rating %}<details class="health" id="ratebox"><summary><span class="dot" id="tokdot"></span>Bewertungen senden: <span id="tokstat">nicht verbunden</span></summary>
    <div style="margin-top:8px"><input id="tok" type="password" autocomplete="off" placeholder="Zugangsschlüssel" style="font:14px var(--sans);padding:6px 10px;border:1px solid var(--rule);border-radius:6px;background:var(--card);color:var(--ink);min-width:240px"> <button type="button" id="toksave">Speichern</button><button type="button" id="tokdel">Entfernen</button></div></details>{% endif %}
  {% set lvl = 'bad' if health|selectattr(1,'equalto','bad')|list else ('warn' if health|selectattr(1,'equalto','warn')|list else 'ok') %}
  <details class="health"><summary><span class="dot {{ lvl }}"></span>Systemstatus: {{ 'alles in Ordnung' if lvl == 'ok' else 'Hinweise beachten' if lvl == 'warn' else 'Störung – Inhalte evtl. unvollständig' }}</summary>
    <ul>{% for n, s, x in health %}<li class="{{ s }}"><span class="dot {{ s }}"></span><b>{{ n }}</b>{{ x }}</li>{% endfor %}</ul></details>
  Quelle der Kennzahlen: Statistisches Bundesamt (Destatis), GENESIS-Online.
</footer></div>

<script>
(function(){
  var $=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};
  
  /* Navigation: markiert den Bereich, der gerade im Bild ist (bei Kacheln beide Nachbarn) */
  var links=$('nav a[href^="#"]'), secs=links.map(function(a){return document.getElementById(a.getAttribute('href').slice(1))}), navEl=document.querySelector('nav'), tick=false;
  function spy(){
    tick=false; var line=navEl.offsetHeight+60, tops=secs.map(function(s){return s?s.getBoundingClientRect().top:1e9}), best=-1e9;
    tops.forEach(function(y){if(y<=line&&y>best)best=y});
    if(window.innerHeight+scrollY>=document.documentElement.scrollHeight-4)best=Math.max.apply(null,tops.filter(function(y){return y<1e8}));
    links.forEach(function(a,i){a.classList.toggle('on',tops[i]<1e8&&Math.abs(tops[i]-best)<3)});
    var on=links.filter(function(a){return a.classList.contains('on')})[0], box=navEl.firstElementChild;
    if(on&&box.scrollWidth>box.clientWidth)box.scrollTo({left:on.offsetLeft-(box.clientWidth-on.offsetWidth)/2,behavior:'smooth'});
  }
  addEventListener('scroll',function(){if(!tick){tick=true;requestAnimationFrame(spy)}},{passive:true});
  addEventListener('resize',spy); spy();

  /* Ampel-Bewertung: lokal merken, gesammelt an GitHub senden (Kommentar im Bewertungs-Issue) */
  var RT={{ rating|tojson if rating else 'null' }};
  if(RT){
    var TOK='', ratings={}, queue=[], flushing=false, timer=null;
    try{TOK=localStorage.getItem('seilTok')||'';ratings=JSON.parse(localStorage.getItem('seilRate')||'{}');queue=JSON.parse(localStorage.getItem('seilQ')||'[]')}catch(e){}
    var saveR=function(){try{localStorage.setItem('seilRate',JSON.stringify(ratings));localStorage.setItem('seilQ',JSON.stringify(queue))}catch(e){}};
    var showR=function(){$('[data-id]').forEach(function(el){
      var r=(ratings[el.dataset.id]||{}).r||el.dataset.rate||'';
      el.querySelectorAll('.rb').forEach(function(b){b.classList.toggle('sel',b.dataset.r===r)})})};
    var stat=function(msg){
      var s=document.getElementById('tokstat'),d=document.getElementById('tokdot'); if(!s)return;
      var txt=msg||(TOK?'verbunden':'nicht verbunden'); if(TOK&&queue.length&&!msg)txt+=' · '+queue.length+' ausstehend';
      s.textContent=txt; d.className='dot '+(msg?'bad':(TOK?'':'warn'))};
    var flush=function(){
      if(!TOK||!queue.length||flushing)return; flushing=true;
      var batch=queue.slice(0,50);
      fetch('https://api.github.com/repos/'+RT.repo+'/issues/'+RT.issue+'/comments',{method:'POST',
        headers:{'Authorization':'Bearer '+TOK,'Accept':'application/vnd.github+json'},body:JSON.stringify({body:JSON.stringify(batch)})})
      .then(function(r){flushing=false;if(r.ok){queue=queue.slice(batch.length);saveR();stat();if(queue.length)flush()}else stat(r.status===401||r.status===403||r.status===404?'Schlüssel prüfen (Fehler '+r.status+')':'Fehler '+r.status)})
      .catch(function(){flushing=false;stat('offline – wird später gesendet')})};
    document.addEventListener('click',function(e){
      var b=e.target.closest&&e.target.closest('.rb'); if(!b)return;
      var el=b.closest('[data-id]'); if(!el)return;
      var now=Date.now(); ratings[el.dataset.id]={r:b.dataset.r,t:now};
      queue=queue.filter(function(q){return q.i!==el.dataset.id}).concat([{i:el.dataset.id,r:b.dataset.r,t:now}]);
      saveR();showR();stat();clearTimeout(timer);timer=setTimeout(flush,3000)});
    var sv=document.getElementById('toksave'),dl=document.getElementById('tokdel');
    if(sv)sv.addEventListener('click',function(){var v=(document.getElementById('tok').value||'').trim();if(!v)return;TOK=v;try{localStorage.setItem('seilTok',v)}catch(e){};document.getElementById('tok').value='';stat();flush()});
    if(dl)dl.addEventListener('click',function(){TOK='';try{localStorage.removeItem('seilTok')}catch(e){};stat()});
    showR();stat();flush();
  }

  /* Rot bewertet = sofort ausblenden (dauerhaft über die Bewertung) */
  var hid={}; try{hid=JSON.parse(localStorage.getItem('seilHide')||'{}')}catch(e){}
  var cut=Date.now()-45*864e5; Object.keys(hid).forEach(function(k){if(hid[k].t<cut)delete hid[k]});
  function saveHid(){try{localStorage.setItem('seilHide',JSON.stringify(hid))}catch(e){}}
  function applyHid(){
    $('[data-id]').forEach(function(el){el.classList.toggle('gone',!!hid[el.dataset.id])});
  }
  document.addEventListener('click',function(e){
    var b=e.target.closest&&e.target.closest('.rb.r'); if(!b)return;
    var el=b.closest('[data-id]'); if(!el)return;
    var a=el.querySelector('a.h'); hid[el.dataset.id]={t:Date.now(),s:(a?a.textContent.trim():'').slice(0,160),u:a?a.href:''};
    saveHid(); applyHid();
  });
  applyHid();
})();
</script>
</body>
</html>
